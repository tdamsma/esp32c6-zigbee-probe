CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
CONFIG_FREERTOS_HZ=1000

# Full RF calibration at every boot. With the default partial calibration
# this board's Wi-Fi receiver found zero access points while BLE and
# 802.15.4 worked, and full calibration fixed it. Costs ~100 ms of boot.
CONFIG_ESP_PHY_RF_CAL_FULL=y

# The Touchlink master key is deliberately NOT in this repository. Touchlink
# against a BILRESA E2490 does not work without it: commissioning completes and
# then every frame is rejected with NWK status 0x12, so the remote pairs and
# does nothing. See TOUCHLINK-INVESTIGATION.md step 11.
#
# You need the ZLL Master Key, index 4, 32 hex characters beginning 9F55 and
# ending EE31. It is not secret: it was posted in March 2015 and has been
# republished continuously since. Where to look is in the Kconfig help and in
# the README, under "The ZLL Master Key". Paste it here or set it with
# `idf.py menuconfig` under "Zigbee probe".
CONFIG_PROBE_TOUCHLINK_MASTER_KEY=""

# Router role. A coordinator cannot be adopted as a Touchlink target: the
# remote creates its own network and adds the target to it. Without this a
# fresh clone reproduces the failure described in TOUCHLINK-INVESTIGATION.md.
CONFIG_PROBE_ROLE_ROUTER=y
